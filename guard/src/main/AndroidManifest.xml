<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <permission android:name="dev.stanislav.focusdeck.guard.permission.SCHEDULE_WAKE"
        android:protectionLevel="signature" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="dev.stanislav.focusdeck" />
        <package android:name="dev.stanislav.focusdeck.qa" />
    </queries>
    <application
        android:label="FocusDeck Guard"
        android:icon="@drawable/guard_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:testOnly="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/no_data_extraction"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name=".GuardActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".GuardAdminReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/guard_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- The platform authenticates senders. Ordinary apps cannot obtain DUMP on their own. -->
        <receiver
            android:name=".AdbRecoveryReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".GuardScheduleReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".WakeRequestReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="dev.stanislav.focusdeck.guard.permission.SCHEDULE_WAKE" />
        <receiver
            android:name=".GuardPolicyReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.admin.action.DEVICE_POLICY_SET_RESULT" />
                <action android:name="android.app.admin.action.DEVICE_POLICY_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
