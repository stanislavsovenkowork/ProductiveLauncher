{
  "manifest_version": 3,
  "name": "FocusDeck — сайты",
  "version": "0.1.0",
  "description": "Визуальное препятствие для выбранных сайтов в окне FocusDeck.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "FocusDeck: связь неизвестна",
    "default_popup": "popup.html"
  }
}
